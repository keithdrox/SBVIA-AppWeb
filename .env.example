# Copiar como .env para desarrollo local y reemplazar los valores sensibles.
DB_USER=sbvia_user
DB_PASSWORD=cambiar_en_desarrollo

# Debe contener al menos 64 caracteres aleatorios en ambientes reales.
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_al_menos_64_caracteres_antes_de_desplegar
JWT_ISSUER=sbvia-api
JWT_AUDIENCE=sbvia-web

# false solo para HTTP local; en producción con HTTPS debe ser true.
COOKIE_SECURE=false

# Retroalimentación con IA (opcional). Por defecto se usa el motor local de reglas.
# Para activar un proveedor externo compatible con OpenAI, definir:
# AI_PROVEEDOR=openai
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=pegar_aqui_la_clave_solo_en_.env_nunca_en_git
# AI_MODELO=gpt-4o-mini
# AI_TIMEOUT_SEGUNDOS=15
