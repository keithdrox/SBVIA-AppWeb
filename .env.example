# Configuracion de Base de Datos
# DB_USER: Usuario de la base de datos PostgreSQL
DB_USER=sbvia_user
# DB_PASSWORD: Password de la base de datos
DB_PASSWORD=sbvia_pass

# Configuracion de JWT para Autenticacion
# JWT_SECRET: Clave secreta para firmar los tokens JWT (minimo 256 bits)
JWT_SECRET=c4f5a8e1b2d3f6a7c8e9d0b1a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1
# JWT_EXPIRATION: Tiempo de expiracion del token en milisegundos
JWT_EXPIRATION=3600000

# Configuracion de Cache (Redis)
# REDIS_URL: URL de conexion al servidor Redis
REDIS_URL=redis://redis:6379
